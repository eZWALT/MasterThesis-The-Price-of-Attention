# ── Streamlit ────────────────────────────────────────────────────────────────
STREAMLIT_PORT=7777

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BIN=/home/<user>/ollama-local/bin/ollama   # path to your ollama binary
OLLAMA_PORT=9999
OLLAMA_MODEL=qwen3.6:35b

# ── vLLM ─────────────────────────────────────────────────────────────────────
VLLM_PORT=8888
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=2048
VLLM_VISIBLE_DEVICES=0,1
