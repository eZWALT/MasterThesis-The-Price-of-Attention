# ── Streamlit ────────────────────────────────────────────────
STREAMLIT_PORT=7777
AD_CLICK_SERVER_PORT=7780

# ── Retrieval (RAG) ──────────────────────────────────────────
USE_RERANKER=1
DENSE_TOP_K=50                # ANN candidates from FAISS → BM25 + reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_USE_TITLE_ONLY=0
RERANKER_DTYPE=bfloat16       # float32 (safe) | bfloat16 (2× faster, half VRAM)
RERANKER_TOP_K=10             # candidates scored by cross-encoder
QUERY_EXPANSION_MODE=hyde
HYDE_MAX_TOKENS=512
HYDE_TOKENS_PER_DOC=100
HYDE_NUM_DOCS=2

# ── Ollama (single GPU) ──────────────────────────────────────
OLLAMA_BIN=/home/<user>/ollama-local/bin/ollama
OLLAMA_PORT=9999
OLLAMA_MODEL=qwen3.6:35b
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=-1
LLM_BACKEND=ollama
LLM_THINK=false

# ── Ollama cluster (multi-GPU, via scripts/start_ollama_cluster.sh) ──
# CLUSTER_BASE_PORT=9991   # first GPU port; subsequent GPUs use +1, +2, …
# CLUSTER_PORT=9999        # nginx frontend port (same as OLLAMA_PORT above)
# OLLAMA_NUM_PARALLEL=4    # concurrent requests per Ollama instance
#
# After starting the cluster, the app uses the same OLLAMA_PORT=9999
# endpoint — nginx round-robins to backends.  No code changes needed.

# ── vLLM ─────────────────────────────────────────────────────
# VLLM_PORT=8888
# VLLM_MODEL=Qwen/Qwen3.5-9B
# VLLM_TENSOR_PARALLEL_SIZE=2
# VLLM_MAX_MODEL_LEN=2048
# VLLM_VISIBLE_DEVICES=0,1

# HF_TOKEN=your_hf_token_here

LOG_LEVEL=DEBUG

# ── EEG / LSL markers (lab sessions) ─────────────────────────
# Required for lab sessions — set to your experiment identifier.
# Without this env var, LSL markers are silently disabled
# (safe for crowd / dev runs).
LSL_MARKER_OUTLET=

# ── Webcam (opt-in via ?webcam=1 flag) ──────────────────────
# Lower these to save disk space. At 30fps/720p, ~1GB per 15 min.
WEBCAM_FPS=30               # target recording fps
WEBCAM_WIDTH=1280           # camera resolution width
WEBCAM_HEIGHT=720           # camera resolution height

# Fake product URL base for ad click tracking (logged as ad_clicked)
AD_CONVERSION_URL_BASE=https://ads.study.local/product
# Public app URL for trackable ad links (must match how participants open the app)
APP_PUBLIC_URL=http://localhost:7777
