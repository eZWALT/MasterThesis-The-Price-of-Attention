# ── Streamlit ────────────────────────────────────────────────────────────────
STREAMLIT_PORT=7777

# ── Retrieval (RAG) ──────────────────────────────────────────────────────────
USE_RERANKER=1
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_USE_TITLE_ONLY=1
RERANKER_TOP_K=25
QUERY_EXPANSION_MODE=hyde
HYDE_MAX_TOKENS=512
HYDE_TOKENS_PER_DOC=100

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BIN=/home/<user>/ollama-local/bin/ollama   # path to your ollama binary
OLLAMA_PORT=9999
OLLAMA_MODEL=qwen3.6:35b
OLLAMA_NUM_CTX=16384       # context window in tokens (16k minimum recommended)
OLLAMA_KEEP_ALIVE=-1       # keep model in VRAM indefinitely (-1), or e.g. 30m
LLM_BACKEND=ollama         # "ollama" (native API) or "openai" (OpenAI-compat, for vLLM)
LLM_THINK=false            # true = enable Qwen3 chain-of-thought (slower); false = direct reply

# ── vLLM ─────────────────────────────────────────────────────────────────────
VLLM_PORT=8888
VLLM_MODEL=Qwen/Qwen3.5-9B
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=2048
VLLM_VISIBLE_DEVICES=0,1
HF_TOKEN=xxxxx